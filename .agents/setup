#!/usr/bin/env bash
set -xeuo pipefail

repo="$(cd "$(dirname "$0")/.." && pwd)"
nix=/nix/var/nix/profiles/default/bin/nix

if ! mountpoint -q /nix && [[ -d /nix/store ]]; then
  echo expected /nix to be a mountpoint >&2
  exit 1
fi

if [[ ! -f /nix.img ]]; then
  sudo rm -f /nix.img.tmp
  sudo truncate -s 32G /nix.img.tmp
  sudo /sbin/mkfs.ext4 -q -F -m 0 -i 8192 \
    -O dir_index,extent,64bit,dir_nlink,metadata_csum \
    -E lazy_itable_init=0,lazy_journal_init=0 \
    /nix.img.tmp
  sudo mv /nix.img.tmp /nix.img
fi

sudo mkdir -p /nix

fstab_entry='/nix.img /nix ext4 loop,noatime,nofail 0 0'
if ! grep -Fqx "$fstab_entry" /etc/fstab; then
  echo "$fstab_entry" | sudo tee -a /etc/fstab >/dev/null
fi

if ! mountpoint -q /nix; then
  sudo mount /nix
fi

if [[ ! -x "$nix" ]]; then
  curl -sSfL https://artifacts.nixos.org/nix-installer \
    | sh -s -- install --enable-flakes --no-confirm
fi

sudo sed -i '/^auto-optimise-store[[:space:]]*=/d' /etc/nix/nix.conf
echo 'auto-optimise-store = false' | sudo tee -a /etc/nix/nix.conf >/dev/null
sudo systemctl stop nix-daemon.service
sudo rm -rf /nix/store/.links
sudo systemctl start nix-daemon.socket

profile_line='. /etc/profile.d/nix.sh'
sed -i '/nix\.sh/d' ~/.bash_profile
echo "$profile_line" >> ~/.bash_profile

"$nix" develop "path:$repo/nix" --command true
